{
  "name": "vericred-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "tsx src/generator/cli.ts",
    "validate": "tsx src/validator/cli.ts",
    "reproduce": "tsx src/tools/reproduce.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx src/tools/seed.ts",
    "dev": "tsx watch src/api/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "lint": "eslint src",
    "start": "node dist/api/server.js",
    "db:deploy": "prisma db push --accept-data-loss",
    "deploy:setup": "node dist/generator/cli.js --quiet && node dist/validator/cli.js && prisma db push --accept-data-loss && node dist/tools/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.73.0",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=20"
  }
}
