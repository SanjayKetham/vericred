# PostgreSQL. If unset or unreachable the API falls back to the generated files in ../data,
# and GET /api/health reports which driver is live.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vericred?schema=public"

# Required to sign JWTs. The server refuses to start in production without it.
JWT_SECRET="dev-only-change-me"

PORT=4000

# Generator seed. Must match the seed the dataset was generated with, or credentials issued
# through the API would be signed with different issuer keys than the ones in the dataset.
SEED=20261022

# Force the file driver even when DATABASE_URL is set: DATA_SOURCE=file
# DATA_SOURCE=file

# Optional. Without it the AI endpoints return their deterministic fallback.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
